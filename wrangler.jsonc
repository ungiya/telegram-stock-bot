{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-stock-news-alert",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-stock-news-db",
      "database_id": "bfe8db9f-a434-4e7c-a1a1-c0185f49e75c",
      "migrations_dir": "migrations"
    }
  ]
}
